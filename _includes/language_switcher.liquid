{% assign current_lang = page.lang | default: site.lang | default: site.default_lang %}
{% assign current_page = page.url | remove_first: "/" %}

{% comment %} For news pages, determine language based on URL path {% endcomment %}
{% if page.url contains '/news/' %}
  {% if page.url contains '/en/news/' %}
    {% assign current_lang = 'en' %}
  {% else %}
    {% assign current_lang = 'zh' %}
  {% endif %}
{% endif %}

<div class="language-switcher">
  <div class="dropdown">
    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="languageDropdown" data-toggle="dropdown" aria-expanded="false">
      <span id="currentLangText">
        {% if current_lang == 'zh' %}
          中文
        {% else %}
          English
        {% endif %}
      </span>
    </button>
    <ul class="dropdown-menu" aria-labelledby="languageDropdown">
      <!-- Always show both languages, let JavaScript determine which one to hide -->
      <li id="lang-zh">
        <a class="dropdown-item" href="javascript:void(0)" onclick="switchLanguage('zh')">
          中文
        </a>
      </li>
      <li id="lang-en">
        <a class="dropdown-item" href="javascript:void(0)" onclick="switchLanguage('en')">
          English
        </a>
      </li>
    </ul>
  </div>
</div>

<script>
function switchLanguage(lang) {
  localStorage.setItem('preferred_language', lang);
  
  // Get current page path
  var currentPath = window.location.pathname;
  var currentSearch = window.location.search;
  
  // Define language mappings
  var languageMappings = {
    'zh': {
      '/': '/',
      '/en/': '/',
      '/projects/': '/zh/projects/',
      '/publications/': '/zh/publications/',
      '/cv/': '/zh/cv/',
      '/teaching/': '/zh/teaching/',
      '/people/': '/zh/people/',
      '/news/': '/zh/news/',
      '/en/news/': '/zh/news/'
    },
    'en': {
      '/': '/en/',
      '/zh/': '/en/',
      '/projects/': '/en/projects/',
      '/publications/': '/en/publications/',
      '/cv/': '/en/cv/',
      '/teaching/': '/en/teaching/',
      '/people/': '/en/people/',
      '/news/': '/en/news/',
      '/zh/news/': '/en/news/'
    }
  };
  
  // Get the mapped path
  var newPath = languageMappings[lang][currentPath] || currentPath;
  
  // If no direct mapping found, try to construct the path
  if (!languageMappings[lang][currentPath]) {
    // Special handling for news article URLs
    if (currentPath.startsWith('/news/')) {
      // Handle news article language switching
      if (lang === 'zh') {
        // Convert English news article to Chinese
        if (currentPath.endsWith('-en/')) {
          newPath = currentPath.replace(/-en\/$/, '/');
        } else {
          newPath = currentPath; // Already Chinese or no language suffix
        }
      } else { // lang === 'en'
        // Convert Chinese news article to English
        if (currentPath.endsWith('-en/')) {
          newPath = currentPath; // Already English
        } else {
          // Check if this is a Chinese article that needs conversion
          var pathWithoutSlash = currentPath.replace(/\/$/, '');
          newPath = pathWithoutSlash + '-en/';
        }
      }
    } else {
      // Standard page language switching
      // Remove existing language prefix
      var cleanPath = currentPath.replace(/^\/(zh|en)\//, '/');
      
      if (lang === 'zh') {
        if (cleanPath === '/') {
          newPath = '/';
        } else {
          newPath = '/zh' + cleanPath;
        }
      } else { // lang === 'en'
        if (cleanPath === '/') {
          newPath = '/en/';
        } else {
          newPath = '/en' + cleanPath;
        }
      }
    }
  }
  
  // Redirect to new language version
  window.location.href = newPath + currentSearch;
}

// Set language on page load
document.addEventListener('DOMContentLoaded', function() {
  var preferredLang = localStorage.getItem('preferred_language');
  var currentPath = window.location.pathname;
  
  // Set default language to Chinese if no preference is stored
  if (!preferredLang) {
    preferredLang = 'zh';
    localStorage.setItem('preferred_language', 'zh');
  }
  
  // Determine current page language
  var currentPageLang = '{{ current_lang }}';
  if (currentPath.startsWith('/news/')) {
    // For news articles, determine language from URL pattern
    if (currentPath.endsWith('-en/')) {
      currentPageLang = 'en';
    } else {
      currentPageLang = 'zh';
    }
  }
  
  // Update language switcher display
  var currentLangText = document.getElementById('currentLangText');
  if (currentLangText) {
    if (currentPageLang === 'zh') {
      currentLangText.textContent = '中文';
    } else {
      currentLangText.textContent = 'English';
    }
  }
  
  // Hide current language option in dropdown and show the other one
  var langZhOption = document.getElementById('lang-zh');
  var langEnOption = document.getElementById('lang-en');
  if (langZhOption && langEnOption) {
    if (currentPageLang === 'zh') {
      // Currently Chinese, hide Chinese option and show English option
      langZhOption.style.display = 'none';
      langEnOption.style.display = 'block';
    } else {
      // Currently English, hide English option and show Chinese option
      langEnOption.style.display = 'none';
      langZhOption.style.display = 'block';
    }
  }
  
  // IMPORTANT: Do not auto-redirect for news articles to prevent infinite loops
  // Only redirect for non-news pages and only if there's a language mismatch
  if (!currentPath.startsWith('/news/')) {
    // Only redirect if user's preferred language differs from current page language
    // and if user is not on a language-specific page already
    if (preferredLang && preferredLang !== currentPageLang) {
      // Don't redirect if user is already on a language-specific page
      if (!(currentPath.startsWith('/zh/') || currentPath.startsWith('/en/'))) {
        switchLanguage(preferredLang);
      }
    }
  }
  
  // If user visits root and no language preference, ensure they see Chinese
  if (currentPath === '/' && !preferredLang) {
    localStorage.setItem('preferred_language', 'zh');
  }
});
</script>

<style>
.language-switcher {
  display: flex;
  align-items: center;
  height: 100%;
}

.language-switcher .dropdown-toggle {
  border: 1px solid var(--global-theme-color);
  color: var(--global-theme-color);
  font-size: 0.9rem;
  padding: 0.5rem 0.8rem;
  display: inline-flex;
  align-items: center;
  height: auto;
  line-height: 1;
  vertical-align: middle;
}

.language-switcher .dropdown-toggle:hover {
  background-color: var(--global-theme-color);
  color: white;
}

.language-switcher .dropdown-menu {
  min-width: 80px;
}

.language-switcher .dropdown-item {
  padding: 0.25rem 0.75rem;
  font-size: 0.875rem;
}

.language-switcher .dropdown-item:hover {
  background-color: var(--global-theme-color);
  color: white;
}

/* Ensure nav-item containing language switcher aligns properly */
.navbar-nav .nav-item:has(.language-switcher) {
  display: flex;
  align-items: center;
}

</style>